{
  "containerName": "hp_bk_op_a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0_zip",
  "payload": {
    "Image": "restic/restic:0.19.1@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510",
    "Entrypoint": [
      "/bin/sh",
      "-c",
      "set -eu\nRO=\"-o s3.bucket-lookup=path\"\nstats=$(restic $RO -o \"s3.region=$HP_REGION\" stats --json --mode restore-size \"$HP_SNAP\")\nneed=$(printf '%s\\n' \"$stats\" | sed -n 's/.*\"total_size\":\\([0-9]*\\).*/\\1/p')\n[ -n \"$need\" ]\nfree=$(df -Pk /a | awk 'NR==2{print $4}')\n[ $((free * 1024)) -ge $((need + HP_FLOOR)) ] || exit 75\nrm -f \"/a/$HP_JOB.part\"\nrestic $RO -o \"s3.region=$HP_REGION\" dump --archive zip \"$HP_SNAP:/backup\" / > \"/a/$HP_JOB.part\"\nsync \"/a/$HP_JOB.part\"\nmv -Tf \"/a/$HP_JOB.part\" \"/a/$HP_JOB.zip\"\nsync /a"
    ],
    "User": "990:990",
    "Hostname": "hosting-panel",
    "Env": [
      "GOMAXPROCS=1",
      "NICE=19",
      "RESTIC_CACHE_DIR=/tmp/cache",
      "RESTIC_REPOSITORY=s3:https://s3.example.test:9000/pin-backups/pins/site-a/sites/site_pin_a",
      "HP_REGION=eu-central-1",
      "HP_SNAP=5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a",
      "HP_JOB=op_a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0",
      "HP_FLOOR=1073741824",
      "AWS_SHARED_CREDENTIALS_FILE=/run/secrets/AWS_SHARED_CREDENTIALS",
      "RESTIC_PASSWORD_FILE=/run/secrets/RESTIC_PASSWORD"
    ],
    "Labels": {
      "io.hostingpanel.managed": "true",
      "io.hostingpanel.role": "site_job",
      "io.hostingpanel.site_id": "site_pin_a",
      "io.hostingpanel.job_id": "op_a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0"
    },
    "HostConfig": {
      "Privileged": false,
      "ReadonlyRootfs": true,
      "CapDrop": [
        "ALL"
      ],
      "SecurityOpt": [
        "no-new-privileges:true"
      ],
      "PidsLimit": 128,
      "NanoCpus": 1000000000,
      "Memory": 536870912,
      "MemorySwap": 536870912,
      "RestartPolicy": {
        "Name": "no"
      },
      "Tmpfs": {
        "/tmp": "rw,nosuid,nodev,noexec,size=128m,mode=1777"
      },
      "LogConfig": {
        "Type": "json-file",
        "Config": {
          "max-size": "1m",
          "max-file": "1"
        }
      },
      "NetworkMode": "hp_backup_net",
      "Binds": [
        "/var/lib/hosting-panel/backups/archives:/a",
        "/run/hosting-panel/secrets/job_bk_zip_op_a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0/AWS_SHARED_CREDENTIALS:/run/secrets/AWS_SHARED_CREDENTIALS:ro",
        "/run/hosting-panel/secrets/job_bk_zip_op_a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0/RESTIC_PASSWORD:/run/secrets/RESTIC_PASSWORD:ro"
      ]
    }
  }
}
