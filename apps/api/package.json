{
  "name": "@hosting-panel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hosting-panel/authz": "workspace:*",
    "@hosting-panel/contracts": "workspace:*",
    "@hosting-panel/database": "workspace:*",
    "@hosting-panel/executor-contracts": "workspace:*",
    "@hosting-panel/host-agent-contracts": "workspace:*",
    "@hosting-panel/hosting-domain": "workspace:*",
    "@hosting-panel/policy-engine": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
