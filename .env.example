# ==============================================================================
# HCP-SPEC-001 v0.1 — Environment Configuration Template (.env.example)
# ==============================================================================
# Questo file documenta tutte le variabili d'ambiente per il monorepo hosting-panel.
# Non contiene credenziali reali (tutti i valori sono segnaposto locali per dev/test).
#
# Copiare questo file in .env per personalizzare l'ambiente locale:
#   cp .env.example .env
#
# Sono supportate due modalità di esecuzione (ADR-002):
# 1. MODALITÀ ZERO-DOCKER STANDALONE (Predefinita out-of-the-box):
#    Nessun container richiesto. Usa PGlite in-memory/embedded per PostgreSQL 18,
#    il Fake Coolify Lab HTTP server embedded (porta 4101) e l'emulatore OIDC locale.
#    Tutte le variabili esterne (DATABASE_URL, COOLIFY_BASE_URL) possono rimanere NON impostate.
#
# 2. MODALITÀ DOCKER COMPOSE / EXTERNAL STAGING:
#    Usa i servizi avviati tramite `docker compose -f infra/local/docker-compose.yml up -d`
#    (PostgreSQL 18.1 alpine, Redis 7.4 alpine, Keycloak 26.2.0) e/o un'istanza Coolify reale.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API CONTROL PLANE (apps/api)
# ------------------------------------------------------------------------------

# Host di ascolto per il server NestJS / Fastify (default: 127.0.0.1)
API_HOST=127.0.0.1

# Porta di ascolto del Control Plane API (default: 4000)
API_PORT=4000

# Origine consentita per CORS dalle richieste web browser (default: http://127.0.0.1:3000)
WEB_ORIGIN=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENZA
# ------------------------------------------------------------------------------

# In modalità Zero-Docker: lasciare commentato o vuoto per usare embedded @electric-sql/pglite.
# In modalità Docker / Staging: decommentare per connettersi a PostgreSQL 18.
# DATABASE_URL=postgresql://hosting_panel:local_dev_db_password@127.0.0.1:5432/hosting_panel_dev
DATABASE_URL=

# Connessione Redis (usata per queue/caching con password autenticata).
# In modalità Zero-Docker: l'Outbox Worker gira in-process con reconciler transazionale.
# In modalità Docker Compose: redis bound su 127.0.0.1:6379 con requirepass.
REDIS_URL=redis://:local_dev_redis_password@127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 3. IDENTITY & OIDC AUTHENTICATION
# ------------------------------------------------------------------------------

# Issuer OIDC per la verifica dei token JWT (Bearer).
# In modalità Zero-Docker: issuer dell'emulatore Dev OIDC locale integrato.
# In modalità Docker Compose con Keycloak: http://127.0.0.1:8080/realms/hosting-panel
OIDC_ISSUER=https://auth.demo.hosting-panel.internal

# Audience attesa nei token JWT dal Control Plane API
OIDC_AUDIENCE=hosting-panel-api

# Abilita o disabilita gli endpoint di emulazione Dev OIDC (/health/personas, /v1/auth/dev-token)
# Deve essere 'true' per la POC autonoma e 'false' in ambienti di staging/produzione rigorosi.
ENABLE_DEV_OIDC=true

# ------------------------------------------------------------------------------
# 4. UPSTREAM COOLIFY INTEGRATION
# ------------------------------------------------------------------------------

# URL base dell'istanza Coolify v4 upstream.
# In modalità Zero-Docker: lasciare NON impostato per avviare il Fake Coolify v4 Lab server embedded.
# In modalità Staging/Real Coolify: impostare l'URL HTTPS dell'istanza Coolify target.
# COOLIFY_BASE_URL=https://coolify.internal:8000
COOLIFY_BASE_URL=

# Porta su cui avviare il Fake Coolify Lab server se non diversamente specificato (default: 4101)
FAKE_COOLIFY_PORT=4101

# ------------------------------------------------------------------------------
# 5. FRONTEND & BACKEND-FOR-FRONTEND (apps/web)
# ------------------------------------------------------------------------------

# URL interno del Control Plane API consumato dal BFF (Server Components & Route Handlers di Next.js).
API_INTERNAL_URL=http://127.0.0.1:4000

# Chiave segreta per la crittografia dei cookie di sessione HttpOnly (minimo 32 caratteri).
# In produzione deve essere una stringa crittograficamente forte (es. generata via `openssl rand -hex 32`).
BFF_SESSION_SECRET=dev_only_bff_session_secret_min_32_characters_long_12345

# Abilita se l'applicazione web è posizionata dietro un reverse proxy (Cloudflare, Traefik, Coolify proxy)
# per fidarsi dell'header X-Forwarded-Proto per i cookie Secure.
BFF_TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 6. INFRASTRUTTURA DOCKER COMPOSE LOCALE (infra/local/docker-compose.yml)
# ------------------------------------------------------------------------------
POSTGRES_USER=hosting_panel
POSTGRES_PASSWORD=local_dev_db_password
POSTGRES_DB=hosting_panel_dev

REDIS_PASSWORD=local_dev_redis_password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_dev_password
