# devflow settings (sourced by bash: KEY=value, quote values containing spaces).

# Branch that receives the squash merges and the automated releases.
MAIN_BRANCH=main

# One command that must pass before a push and before a PR is marked ready. Empty = no check.
VERIFY_CMD="corepack pnpm run build && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test"

# Lighter check for .githooks/pre-push when CI already runs VERIFY_CMD in full, e.g. only the
# tests related to the change. Empty = VERIFY_CMD. A push of commits that already passed it
# from a clean checkout, or a push that only deletes branches, skips the check.
# Here: only the tests related to the change since origin/main; forceRerunTriggers in
# vitest.config.ts runs the whole suite when shared packages, migrations or infra change.
PUSH_VERIFY_CMD="corepack pnpm run build && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test --changed origin/main --passWithNoTests"

# Paths whose changes bump no package and stay out of the release notes (bash globs, * also
# matches /). Default: CI and the workflow tooling. A merge that only touches them is not released
# when RELEASE_TAG is set; its commits join no changelog entry.
# Here also the agent contract, lint/test configuration, tests and docs: they do not change the archive.
BUMP_IGNORE='.github/* .woodpecker/* .githooks/* .devflow/* scripts/devflow/* .agents/* AGENTS.md CLAUDE.md HARNESS.md vitest.config.ts eslint.config.mjs .editorconfig test/* *.test.ts apps/*/test/* packages/*/test/* infra/*/test/* docs/*'

# Timezone of the release tags (YYYYMMDD-HHMM) and of the changelog dates.
RELEASE_TZ=Europe/Rome

# Tag of the GitHub Release. Empty = the timestamp YYYYMMDD-HHMM (RELEASE_TZ). {version} is the
# version of the first package in .devflow/packages, e.g. RELEASE_TAG='v{version}' gives v1.4.0.
RELEASE_TAG='v{version}'

# true = create the release as a draft; a later CI job uploads its files and publishes it
# (gh release edit "$TAG" --draft=false --latest). false = published at once and marked latest.
RELEASE_DRAFT=true
