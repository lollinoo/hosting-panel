[Unit]
Description=Hosting Panel Control Plane API, Outbox Worker & Drift Reconciler (HCP-SPEC-003 Domain 1)
Documentation=https://hosting-panel.internal/docs/hcp-spec-003
After=systemd-tmpfiles-setup.service network-online.target hp-docker-executor.service hp-host-agent.service
Wants=network-online.target hp-docker-executor.service hp-host-agent.service

[Service]
Type=simple
User=hp-api
Group=hp-api
SupplementaryGroups=hp-ipc
WorkingDirectory=/opt/hosting-panel/current/apps/api
EnvironmentFile=/etc/hosting-panel/api.env
Environment=NODE_ENV=production
Environment=HP_RUNTIME_BACKEND=linux-systemd
Environment=HP_EXECUTOR_SOCKET_PATH=/run/hosting-panel/executor.sock
Environment=HP_HOST_AGENT_SOCKET_PATH=/run/hosting-panel/host-agent.sock
Environment=HP_IPC_KEY_FILE=/etc/hosting-panel/ipc.key
Environment=HP_SECRETS_MASTER_KEY_FILE=/etc/hosting-panel/secrets-master.key
Environment=HP_BREAKGLASS_KEY_FILE=/etc/hosting-panel/breakglass-jwt.key
Environment=HP_JWT_SIGNING_KEY_FILE=/etc/hosting-panel/jwt-signing.pem
ExecStart=/usr/bin/node /opt/hosting-panel/current/apps/api/dist/main.js
Restart=on-failure
RestartSec=5s
UMask=0027

# Shared UDS IPC directory (/run/hosting-panel 3770 root:hp-ipc managed via tmpfiles.d)
ReadWritePaths=/run/hosting-panel

# HCP-SPEC-003 §5.2 Mandatory Hardening Matrix
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
InaccessiblePaths=/var/run/docker.sock
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
